# Copy to .env to override. Filenames are relative to ./models.
# Pool for model id qwen3-1.7b (profile qwen3)
CODER_MODEL=Qwen3-1.7B-Q4_K_M.gguf
# off|on|auto: Qwen3 thinking. Keep off for tool calling.
CODER_REASONING=off
# Total context and slots for qwen3-1.7b; each request gets CODER_CTX / CODER_PARALLEL tokens
# (16384 by default). Keep that under the model's 40,960-token training context.
CODER_CTX=32768
CODER_PARALLEL=2
# KV cache type: q8_0 holds twice the context of f16 in the same memory (56 vs 112 KiB per token).
CODER_KV_TYPE=q8_0
# Host-RAM prompt cache caps in MiB (llama-server's default 8192 can OOM the VM).
CODER_CACHE_RAM=1024
QWEN25_CACHE_RAM=512
# Pool for model id qwen2.5-coder-1.5b
QWEN25_CODER_MODEL=qwen2.5-coder-1.5b-instruct-q4_k_m.gguf
# Pool for model id gemma-4-e2b (the default pool)
GEMMA_MODEL=gemma-4-E2B-it-Q4_K_M.gguf
GEMMA_MMPROJ=gemma-4-E2B-it-mmproj-F16.gguf
GEMMA_CACHE_RAM=512
VISION_MODEL=PaddleOCR-VL-1.6.gguf
VISION_MMPROJ=PaddleOCR-VL-1.6-mmproj.gguf
EMBED_MODEL=nomic-embed-text-v1.5.Q4_K_M.gguf
# Slots per llama-server process (continuous batching).
LLAMA_PARALLEL=4
