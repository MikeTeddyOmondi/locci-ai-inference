# Copy to .env. `just examples-env` builds one from the original projects.

# Locci AI Gateway, through @locci/ai-sdk
LOCCI_AI_BASE_URL=http://localhost:8080/v1
LOCCI_AUTH_URL=http://localhost:8787
# A Locci API key (exchanged for 1h access tokens), or LOCCI_ACCESS_TOKEN.
LOCCI_API_KEY=
# Gateway model id: qwen3-1.7b (tools) or qwen2.5-coder-1.5b (code only).
MODEL=qwen3-1.7b

PORT=3939
# Origins allowed to call the API from a browser (the web example).
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# Web tools (from autonomous-chatbot). Each tool is skipped if its key is empty.
OPENWEATHERMAP_API_KEY=
FIRECRAWL_API_KEY=
# Characters of search results (all results together) handed to the model.
# ~4 characters per token; keep it well under the model's context (8192 per slot).
SEARCH_MAX_CHARS=4000
# The model's context per request (llama-server -c divided by --parallel); 16384
# for qwen3-1.7b with the stack's defaults. Leave unset to use the built-in value
# per model (src/provider.ts); set it if you change CODER_CTX or CODER_PARALLEL.
# The web endpoint fits each conversation into what is left after the system
# prompt and tool schemas (measured at startup), a tool result and the answer;
# longer pastes and histories are shortened. If the model still rejects a request
# as too long, it is shortened by the reported excess and retried once.
# MODEL_CONTEXT_TOKENS=16384
# Plan and run a web search before answering (src/search-plan.ts), once per turn;
# skipped for small talk, attachments, weather, translation and reworking earlier
# text. off lets the model decide when to search.
AUTO_SEARCH=on
# Resumable web replies: memory (default) records each reply so a page reload
# resumes it and a repeated request id replays it; ursula records to Ursula
# through KrakenD's /v1/streams and the Ursula gateway behind it (see the
# README), which survives API restarts and works across API instances; off
# disables recording.
RESUMABLE_STREAMS=memory
# URSULA_URL=http://localhost:8080/v1/streams
# Sign-in for the web routes (/api/chat, /api/threads): off (default) needs
# none; locci needs a Locci access token (Authorization: Bearer). The web app
# signs in against LOCCI_AUTH_URL with PKCE, as client AUTH_CLIENT_ID, and
# threads and recordings are then kept per user.
AUTH=off
# AUTH_CLIENT_ID=locci-ai-chat
# Tools the web chat (/api/chat) may call: a comma list of names, or all. Default:
# the built-ins (weather,search). The CLI and TUI always get every tool.
# WEB_TOOLS=weather,search
# Optional hard cap, in characters, on the conversation sent to the model.
# MAX_INPUT_CHARS=8000

# MCP tools (from locci-chat-cli). On when mcp.json exists or MCP_ENABLED=1;
# MCP_ENABLED=0 forces it off. See mcp.example.json.
MCP_ENABLED=0
MCP_CONFIG=./mcp.json
# Single-server fallback, used only when there is no usable mcp.json.
MCP_COMMAND=
MCP_ARGS=

# Server-side threads (plumbing for later; the web example uses IndexedDB).
# THREAD_STORE=libsql
# THREADS_DB_URL=file:./data/threads.db
