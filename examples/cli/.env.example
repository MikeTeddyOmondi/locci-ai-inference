# The example API (examples/api). The CLI and TUI talk only to it.
API_URL=http://localhost:3939
# With AUTH=locci on the API, /chat needs a Locci token: an API key (exchanged
# for a token at LOCCI_AUTH_URL/keys/token) or a token as-is.
# LOCCI_API_KEY=
# LOCCI_ACCESS_TOKEN=
# LOCCI_AUTH_URL=https://auth.locci.cloud
