{
  "name": "@locci/example-ai-cli",
  "version": "0.1.0",
  "private": true,
  "description": "locci-chat-cli ported as a pure client of the example API (examples/api)",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "bin": {
    "locci-chat": "./src/cli.ts"
  },
  "scripts": {
    "cli": "tsx src/cli.ts",
    "status": "tsx src/cli.ts status",
    "chat": "tsx src/cli.ts chat",
    "ask": "tsx src/cli.ts ask",
    "mcp": "tsx src/cli.ts mcp list",
    "tui": "bun src/tui.tsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@openauthjs/openauth": "0.4.3",
    "@opentui/core": "0.4.5",
    "@opentui/react": "0.4.5",
    "commander": "15.0.0",
    "dotenv": "17.4.2",
    "react": "19.3.0",
    "satteri": "0.9.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
