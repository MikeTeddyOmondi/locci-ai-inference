# The example API (examples/api). The CLI and TUI talk only to it.
API_URL=http://localhost:3939
# With AUTH=locci on the API, /chat needs a Locci token. Run `locci-chat login`
# (`just examples-cli login`) to sign in in the browser; the session is kept in
# ~/.locci/ai-chat-cli.json and refreshed as needed. Either variable below takes
# precedence over the login: an API key (exchanged at LOCCI_AUTH_URL/keys/token)
# or a token as-is. LOCCI_AUTH_URL also picks the login's issuer (default: the
# API's, from its /info).
# LOCCI_API_KEY=
# LOCCI_ACCESS_TOKEN=
# LOCCI_AUTH_URL=https://auth.locci.cloud
